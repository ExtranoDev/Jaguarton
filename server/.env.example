NODE_ENV=development
PORT=4000
# Required (no fallback) when NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# What "a day" means for slots/availability. Keep this fixed: hosts run in UTC.
APP_TIMEZONE=Africa/Lagos

# Local dev uses SQLite. Set DB_CLIENT=pg + DATABASE_URL to develop against Postgres.
DB_CLIENT=sqlite3
# Postgres connection string (required in production, e.g. from Neon)
DATABASE_URL=

# Optional: run `npm test` against Postgres instead of SQLite. WARNING: the test
# suite deletes all rows, so use a throwaway database or Neon branch.
TEST_DATABASE_URL=

# Optional: password for the seeded demo accounts (default: password123)
SEED_PASSWORD=
